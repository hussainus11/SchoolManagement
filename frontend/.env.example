# Base URL of the backend API (no trailing slash).
# Local dev default matches the backend's default PORT (3001).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public URL this frontend is deployed at (used for SEO metadata only).
# Set to your Netlify URL (or custom domain) in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# WhatsApp Embedded Signup (Meta JS SDK). Both values are NOT secret — Meta's own client-side SDK
# requires them — but the App Secret must never appear here or anywhere in the frontend. Must
# match META_APP_ID / META_EMBEDDED_SIGNUP_CONFIG_ID in the backend's .env. See
# docs/whatsapp-meta-setup.md.
NEXT_PUBLIC_META_APP_ID="your-meta-app-id"
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID="your-embedded-signup-config-id"
