# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts imports "dotenv/config" so .env is loaded when running Nest/Prisma CLI commands.

# PostgreSQL connection string. URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/schoolmanagement_db?schema=public"

# App
PORT=3001
FRONTEND_ORIGIN="http://localhost:3002"

# Auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
