# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts imports "dotenv/config" so .env is loaded when running Nest/Prisma CLI commands.

# PostgreSQL connection string. URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/schoolmanagement_db?schema=public"

# App
PORT=3001
# Comma-separated list of allowed frontend origins (no trailing slash), e.g. your
# Netlify production URL plus a custom domain. Localhost is always allowed for dev,
# so you never need to add it here.
FRONTEND_ORIGIN="https://your-app.netlify.app"

# Auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME="refresh_token"
# Must be "true" in production (Render, or any deploy where the frontend is on a
# different domain than the backend) — it also flips the refresh cookie's SameSite
# to "none", which cross-site requests require. Keep "false" for local http dev.
COOKIE_SECURE=false

# Mail (used for "forgot password" reset links). Optional — without these set, reset emails are
# logged to the server console instead of sent, so the flow still works for local dev.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey-or-username"
SMTP_PASSWORD="change-me"
SMTP_FROM="no-reply@yourschool.com"

# WhatsApp (Meta Cloud API + Embedded Signup) — see docs/whatsapp-meta-setup.md for how to obtain
# each of these from the Meta App Dashboard. Without these set, the WhatsApp module still loads,
# but /whatsapp/connect and message sending will fail (schools just won't see a working "Connect
# WhatsApp" button until it's configured).
# App ID from your Meta App's dashboard (Settings > Basic). Also needed by the frontend as
# NEXT_PUBLIC_META_APP_ID — it's not secret, Meta's own JS SDK requires it client-side.
META_APP_ID="your-meta-app-id"
# App Secret from the same page. NEVER expose this to the frontend or logs — used only
# server-side to exchange the Embedded Signup code for an access token.
META_APP_SECRET="change-me"
# Graph API version to call. Bump periodically; Meta deprecates versions ~2 years after release.
META_GRAPH_API_VERSION="v22.0"
# Configuration ID for your Embedded Signup flow (Meta App Dashboard > WhatsApp > Embedded Signup
# configuration, or Facebook Login for Business > Configurations). Also needed by the frontend as
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID.
META_EMBEDDED_SIGNUP_CONFIG_ID="your-embedded-signup-config-id"
# Any random string you choose — entered in Meta App Dashboard > WhatsApp > Configuration >
# Webhooks when you set the callback URL, so Meta's verification handshake can be checked here.
META_WEBHOOK_VERIFY_TOKEN="change-me-to-a-random-string"

# 32-byte key (base64 or 64-char hex) used to AES-256-GCM encrypt each school's WhatsApp access
# token before it's stored in Postgres. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key invalidates every stored WhatsApp connection (schools would need to reconnect).
WHATSAPP_ENCRYPTION_KEY="change-me-to-a-32-byte-base64-or-hex-key"
