# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts imports "dotenv/config" so .env is loaded when running Nest/Prisma CLI commands.

# PostgreSQL connection string. URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/schoolmanagement_db?schema=public"

# App
PORT=3001
# Comma-separated list of allowed frontend origins (no trailing slash), e.g. your
# Netlify production URL plus a custom domain. Localhost is always allowed for dev,
# so you never need to add it here.
FRONTEND_ORIGIN="https://your-app.netlify.app"

# Auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME="refresh_token"
# Must be "true" in production (Render, or any deploy where the frontend is on a
# different domain than the backend) — it also flips the refresh cookie's SameSite
# to "none", which cross-site requests require. Keep "false" for local http dev.
COOKIE_SECURE=false

# Mail (used for "forgot password" reset links). Optional — without these set, reset emails are
# logged to the server console instead of sent, so the flow still works for local dev.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey-or-username"
SMTP_PASSWORD="change-me"
SMTP_FROM="no-reply@yourschool.com"
