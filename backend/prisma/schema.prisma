// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  BRANCH_ADMIN
  TEACHER
  ACCOUNTANT
  STAFF
  PARENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EventType {
  HOLIDAY
  EXAM
  MEETING
  ACTIVITY
  OTHER
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PayslipStatus {
  DRAFT
  FINALIZED
  PAID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum NotificationType {
  ANNOUNCEMENT
  FEE_DUE
  ASSIGNMENT
  GENERAL
}

enum AdmissionStatus {
  INQUIRY
  APPLIED
  TEST_SCHEDULED
  TEST_COMPLETED
  OFFERED
  ENROLLED
  REJECTED
  WITHDRAWN
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  LOST
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssetStatus {
  IN_USE
  IN_STORAGE
  UNDER_REPAIR
  DISPOSED
}

enum DisciplineSeverity {
  MINOR
  MODERATE
  MAJOR
}

enum DocumentOwnerType {
  TEACHER
  STUDENT
  STAFF
}

model School {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  email                    String?
  phone                    String?
  address                  String?
  logoUrl                  String?
  idCardBackgroundColor    String   @default("#1E3A8A")
  idCardForegroundColor    String   @default("#FFFFFF")
  idCardBackgroundImageUrl String?
  isActive                 Boolean  @default(true)
  /** When this school's current trial/paid period ends. Set to now + 10 days on registration;
   *  extended by a SUPER_ADMIN via BillingRecord when the school pays. */
  nextBillingDate          DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  branches            Branch[]
  academicYears       AcademicYear[]
  users               User[]
  auditLogs           AuditLog[]
  classes             Class[]
  subjects            Subject[]
  teachers            Teacher[]
  staff               Staff[]
  students            Student[]
  guardians           Guardian[]
  studentAttendances  StudentAttendance[]
  teacherAttendances  TeacherAttendance[]
  periods             Period[]
  timetableEntries    TimetableEntry[]
  events              SchoolEvent[]
  feeHeads            FeeHead[]
  feeStructures       FeeStructure[]
  studentDiscounts    StudentDiscount[]
  invoices            Invoice[]
  payments            Payment[]
  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  expenseCategories   ExpenseCategory[]
  vendors             Vendor[]
  expenses            Expense[]
  rooms               Room[]
  examTypes           ExamType[]
  exams               Exam[]
  examSchedules       ExamSchedule[]
  gradeScales         GradeScale[]
  marks               Mark[]
  assignments         Assignment[]
  announcements       Announcement[]
  notifications       Notification[]
  admissions          Admission[]
  books               Book[]
  bookIssues          BookIssue[]
  vehicles            Vehicle[]
  routes              Route[]
  studentTransports   StudentTransport[]
  hostels             Hostel[]
  hostelAllocations   HostelAllocation[]
  assetCategories     AssetCategory[]
  assets              Asset[]
  leaveTypes          LeaveType[]
  leaveGroups         LeaveGroup[]
  leaveRequests       LeaveRequest[]
  disciplineIncidents DisciplineIncident[]
  visitors            Visitor[]
  alumni              Alumni[]
  documents           Document[]
  customRoles         CustomRole[]
  billingRecords      BillingRecord[]
}

/** One entry per time a SUPER_ADMIN extends a school's billing period, e.g. after receiving
 *  payment. periodStart/periodEnd capture what span this specific extension covers. */
model BillingRecord {
  id           String   @id @default(cuid())
  schoolId     String
  amount       Decimal? @db.Decimal(10, 2)
  note         String?
  periodStart  DateTime
  periodEnd    DateTime
  recordedById String
  createdAt    DateTime @default(now())

  school     School @relation(fields: [schoolId], references: [id])
  recordedBy User   @relation("BillingRecordedBy", fields: [recordedById], references: [id])

  @@index([schoolId])
}

model Branch {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  users         User[]
  classes       Class[]
  teachers      Teacher[]
  staff         Staff[]
  students      Student[]
  periods       Period[]
  events        SchoolEvent[]
  expenses      Expense[]
  rooms         Room[]
  examSchedules ExamSchedule[]
  announcements Announcement[]
  admissions    Admission[]
  vehicles      Vehicle[]
  hostels       Hostel[]
  assets        Asset[]
  visitors      Visitor[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  classes            Class[]
  studentAttendances StudentAttendance[]
  teacherAttendances TeacherAttendance[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  exams              Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String?
  branchId           String?
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  school                   School?                @relation(fields: [schoolId], references: [id])
  branch                   Branch?                @relation(fields: [branchId], references: [id])
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  teacher                  Teacher?
  staff                    Staff?
  student                  Student?
  guardian                 Guardian?
  markedStudentAttendances StudentAttendance[]
  markedTeacherAttendances TeacherAttendance[]
  createdEvents            SchoolEvent[]
  recordedPayments         Payment[]
  salaryStructures         SalaryStructure[]
  payslips                 Payslip[]
  requestedExpenses        Expense[]              @relation("ExpenseRequestedBy")
  approvedExpenses         Expense[]              @relation("ExpenseApprovedBy")
  enteredMarks             Mark[]
  gradedSubmissions        AssignmentSubmission[] @relation("GradedSubmissions")
  createdAnnouncements     Announcement[]
  notifications            Notification[]
  issuedBookIssues         BookIssue[]            @relation("BookIssuedBy")
  approvedLeaveRequests    LeaveRequest[]         @relation("LeaveApprovedBy")
  reportedIncidents        DisciplineIncident[]   @relation("IncidentReportedBy")
  uploadedDocuments        Document[]
  recordedBillingRecords   BillingRecord[]        @relation("BillingRecordedBy")
  passwordResetTokens      PasswordResetToken[]

  @@index([schoolId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([schoolId, entityType, entityId])
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  branchId       String
  academicYearId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id])
  sections      Section[]
  classSubjects ClassSubject[]
  feeStructures FeeStructure[]
  examSchedules ExamSchedule[]

  @@unique([branchId, academicYearId, name])
  @@index([schoolId])
}

model Section {
  id             String   @id @default(cuid())
  classId        String
  name           String
  capacity       Int?
  classTeacherId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class             Class               @relation(fields: [classId], references: [id])
  classTeacher      Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students          Student[]
  subjectTeachers   SubjectTeacher[]
  attendances       StudentAttendance[]
  timetableEntries  TimetableEntry[]
  assignments       Assignment[]
  offeredAdmissions Admission[]

  @@unique([classId, name])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id])
  classSubjects    ClassSubject[]
  subjectTeachers  SubjectTeacher[]
  timetableEntries TimetableEntry[]
  examSchedules    ExamSchedule[]
  assignments      Assignment[]

  @@unique([schoolId, code])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
}

model SubjectTeacher {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  teacherId String
  createdAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, subjectId])
}

model Teacher {
  id             String    @id @default(cuid())
  userId         String    @unique
  schoolId       String
  branchId       String
  customRoleId   String?
  leaveGroupId   String?
  employeeCode   String
  photoUrl       String?
  gender         Gender?
  dateOfBirth    DateTime?
  joiningDate    DateTime  @default(now())
  address        String?
  emergencyPhone String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user             User                   @relation(fields: [userId], references: [id])
  school           School                 @relation(fields: [schoolId], references: [id])
  branch           Branch                 @relation(fields: [branchId], references: [id])
  customRole       CustomRole?            @relation(fields: [customRoleId], references: [id])
  leaveGroup       LeaveGroup?            @relation(fields: [leaveGroupId], references: [id])
  qualifications   TeacherQualification[]
  classTeacherOf   Section?               @relation("ClassTeacher")
  subjectTeachers  SubjectTeacher[]
  attendances      TeacherAttendance[]
  timetableEntries TimetableEntry[]
  assignments      Assignment[]
  bookIssues       BookIssue[]
  assignedAssets   Asset[]
  leaveRequests    LeaveRequest[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
}

model TeacherQualification {
  id            String   @id @default(cuid())
  teacherId     String
  degree        String
  institution   String?
  yearCompleted Int?
  createdAt     DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model Staff {
  id             String    @id @default(cuid())
  userId         String    @unique
  schoolId       String
  branchId       String
  customRoleId   String?
  leaveGroupId   String?
  employeeCode   String
  designation    String
  photoUrl       String?
  gender         Gender?
  dateOfBirth    DateTime?
  joiningDate    DateTime  @default(now())
  address        String?
  emergencyPhone String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user          User           @relation(fields: [userId], references: [id])
  school        School         @relation(fields: [schoolId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  customRole    CustomRole?    @relation(fields: [customRoleId], references: [id])
  leaveGroup    LeaveGroup?    @relation(fields: [leaveGroupId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
}

model CustomRole {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  allowLogin Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  teachers    Teacher[]
  staff       Staff[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model RolePermission {
  id           String @id @default(cuid())
  customRoleId String
  resource     String

  customRole CustomRole @relation(fields: [customRoleId], references: [id])

  @@unique([customRoleId, resource])
  @@index([customRoleId])
}

model Student {
  id              String         @id @default(cuid())
  userId          String?        @unique
  schoolId        String
  branchId        String
  sectionId       String?
  admissionNumber String
  firstName       String
  lastName        String
  photoUrl        String?
  gender          Gender?
  dateOfBirth     DateTime?
  bloodGroup      String?
  address         String?
  admissionDate   DateTime       @default(now())
  academicStatus  AcademicStatus @default(ACTIVE)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  user                User?                  @relation(fields: [userId], references: [id])
  school              School                 @relation(fields: [schoolId], references: [id])
  branch              Branch                 @relation(fields: [branchId], references: [id])
  section             Section?               @relation(fields: [sectionId], references: [id])
  guardians           StudentGuardian[]
  attendances         StudentAttendance[]
  discounts           StudentDiscount[]
  invoices            Invoice[]
  marks               Mark[]
  submissions         AssignmentSubmission[]
  admission           Admission?
  bookIssues          BookIssue[]
  transport           StudentTransport?
  hostelAllocations   HostelAllocation[]
  disciplineIncidents DisciplineIncident[]
  alumniRecord        Alumni?

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([sectionId])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?  @unique
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
}

model StudentGuardian {
  id         String           @id @default(cuid())
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)
  createdAt  DateTime         @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
}

model StudentAttendance {
  id             String           @id @default(cuid())
  schoolId       String
  academicYearId String
  sectionId      String
  studentId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  markedById     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  markedBy     User         @relation(fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([schoolId, sectionId, date])
}

model TeacherAttendance {
  id             String           @id @default(cuid())
  schoolId       String
  academicYearId String
  teacherId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  markedById     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  markedBy     User         @relation(fields: [markedById], references: [id])

  @@unique([teacherId, date])
  @@index([schoolId, date])
}

model Period {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String
  name      String
  startTime String
  endTime   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])
  timetableEntries TimetableEntry[]

  @@unique([branchId, name])
  @@index([schoolId])
}

model TimetableEntry {
  id        String    @id @default(cuid())
  schoolId  String
  sectionId String
  periodId  String
  dayOfWeek DayOfWeek
  subjectId String
  teacherId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  period  Period  @relation(fields: [periodId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, periodId, dayOfWeek])
  @@index([schoolId])
  @@index([teacherId, periodId, dayOfWeek])
}

model SchoolEvent {
  id          String    @id @default(cuid())
  schoolId    String
  branchId    String?
  title       String
  description String?
  location    String?
  type        EventType
  startDate   DateTime
  endDate     DateTime
  isAllDay    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school    School  @relation(fields: [schoolId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([schoolId, startDate, endDate])
}

model FeeHead {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School            @relation(fields: [schoolId], references: [id])
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]
  discounts     StudentDiscount[]

  @@unique([schoolId, name])
}

model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  classId        String
  feeHeadId      String
  academicYearId String
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([classId, feeHeadId, academicYearId])
  @@index([schoolId])
}

model StudentDiscount {
  id        String       @id @default(cuid())
  schoolId  String
  studentId String
  feeHeadId String?
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  reason    String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  school  School   @relation(fields: [schoolId], references: [id])
  student Student  @relation(fields: [studentId], references: [id])
  feeHead FeeHead? @relation(fields: [feeHeadId], references: [id])

  @@index([schoolId, studentId])
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  invoiceNumber  String
  period         String
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(10, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(10, 2)
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  school       School        @relation(fields: [schoolId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  feeHeadId String
  amount    Decimal  @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])
}

model Payment {
  id           String        @id @default(cuid())
  schoolId     String
  invoiceId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  school     School  @relation(fields: [schoolId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([schoolId, invoiceId])
}

model SalaryStructure {
  id              String   @id @default(cuid())
  schoolId        String
  userId          String
  basicSalary     Decimal  @db.Decimal(10, 2)
  allowances      Decimal  @default(0) @db.Decimal(10, 2)
  fixedDeductions Decimal  @default(0) @db.Decimal(10, 2)
  effectiveFrom   DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  payslips Payslip[]

  @@index([schoolId, userId])
}

model Payslip {
  id                  String        @id @default(cuid())
  schoolId            String
  userId              String
  salaryStructureId   String
  month               String
  basicSalary         Decimal       @db.Decimal(10, 2)
  allowances          Decimal       @db.Decimal(10, 2)
  attendanceDeduction Decimal       @default(0) @db.Decimal(10, 2)
  otherDeductions     Decimal       @default(0) @db.Decimal(10, 2)
  netSalary           Decimal       @db.Decimal(10, 2)
  status              PayslipStatus @default(DRAFT)
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  school          School          @relation(fields: [schoolId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  @@unique([userId, month])
  @@index([schoolId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id])
  expenses Expense[]

  @@unique([schoolId, name])
}

model Vendor {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id])
  expenses Expense[]

  @@index([schoolId])
}

model Expense {
  id            String        @id @default(cuid())
  schoolId      String
  branchId      String
  categoryId    String
  vendorId      String?
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  expenseDate   DateTime
  status        ExpenseStatus @default(PENDING)
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  school      School          @relation(fields: [schoolId], references: [id])
  branch      Branch          @relation(fields: [branchId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendor      Vendor?         @relation(fields: [vendorId], references: [id])
  requestedBy User            @relation("ExpenseRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@index([schoolId, status])
}

model Room {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String
  name      String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  examSchedules ExamSchedule[]

  @@unique([branchId, name])
  @@index([schoolId])
}

model ExamType {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  exams  Exam[]

  @@unique([schoolId, name])
}

model Exam {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  examTypeId     String
  name           String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id])
  examType      ExamType       @relation(fields: [examTypeId], references: [id])
  examSchedules ExamSchedule[]

  @@index([schoolId, academicYearId])
}

model ExamSchedule {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String
  examId    String
  classId   String
  subjectId String
  roomId    String
  examDate  DateTime
  startTime String
  endTime   String
  maxMarks  Decimal  @db.Decimal(6, 2)
  passMarks Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  exam    Exam    @relation(fields: [examId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])
  marks   Mark[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId])
  @@index([roomId, examDate])
}

model GradeScale {
  id            String   @id @default(cuid())
  schoolId      String
  grade         String
  minPercentage Decimal  @db.Decimal(5, 2)
  maxPercentage Decimal  @db.Decimal(5, 2)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, grade])
  @@index([schoolId])
}

model Mark {
  id             String   @id @default(cuid())
  schoolId       String
  examScheduleId String
  studentId      String
  marksObtained  Decimal? @db.Decimal(6, 2)
  isAbsent       Boolean  @default(false)
  remarks        String?
  enteredById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  enteredBy    User         @relation(fields: [enteredById], references: [id])

  @@unique([examScheduleId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model Assignment {
  id           String    @id @default(cuid())
  schoolId     String
  sectionId    String
  subjectId    String
  teacherId    String
  title        String
  description  String?
  assignedDate DateTime  @default(now())
  dueDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school      School                 @relation(fields: [schoolId], references: [id])
  section     Section                @relation(fields: [sectionId], references: [id])
  subject     Subject                @relation(fields: [subjectId], references: [id])
  teacher     Teacher                @relation(fields: [teacherId], references: [id])
  submissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([sectionId])
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  schoolId       String
  assignmentId   String
  studentId      String
  status         SubmissionStatus @default(PENDING)
  submissionText String?
  submittedAt    DateTime?
  marksObtained  Decimal?         @db.Decimal(6, 2)
  feedback       String?
  gradedById     String?
  gradedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
  gradedBy   User?      @relation("GradedSubmissions", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model Announcement {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  title       String
  body        String
  targetRoles Role[]
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  notifications Notification[]

  @@index([schoolId])
}

model Notification {
  id             String           @id @default(cuid())
  schoolId       String
  userId         String
  announcementId String?
  type           NotificationType @default(GENERAL)
  title          String
  body           String
  link           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  school       School        @relation(fields: [schoolId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id])

  @@index([schoolId, userId, isRead])
}

model Admission {
  id                 String          @id @default(cuid())
  schoolId           String
  branchId           String
  applicantFirstName String
  applicantLastName  String
  dateOfBirth        DateTime?
  gender             Gender?
  gradeAppliedFor    String
  guardianName       String
  guardianPhone      String
  guardianEmail      String?
  source             String?
  status             AdmissionStatus @default(INQUIRY)
  testScore          Decimal?        @db.Decimal(6, 2)
  testDate           DateTime?
  offeredSectionId   String?
  notes              String?
  convertedStudentId String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  school           School   @relation(fields: [schoolId], references: [id])
  branch           Branch   @relation(fields: [branchId], references: [id])
  offeredSection   Section? @relation(fields: [offeredSectionId], references: [id])
  convertedStudent Student? @relation(fields: [convertedStudentId], references: [id])

  @@index([schoolId, status])
}

model Book {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  author          String?
  isbn            String?
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School      @relation(fields: [schoolId], references: [id])
  issues BookIssue[]

  @@index([schoolId])
}

model BookIssue {
  id         String          @id @default(cuid())
  schoolId   String
  bookId     String
  studentId  String?
  teacherId  String?
  issueDate  DateTime        @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     BookIssueStatus @default(ISSUED)
  fineAmount Decimal?        @db.Decimal(8, 2)
  issuedById String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  school   School   @relation(fields: [schoolId], references: [id])
  book     Book     @relation(fields: [bookId], references: [id])
  student  Student? @relation(fields: [studentId], references: [id])
  teacher  Teacher? @relation(fields: [teacherId], references: [id])
  issuedBy User     @relation("BookIssuedBy", fields: [issuedById], references: [id])

  @@index([schoolId, status])
  @@index([bookId])
}

model Vehicle {
  id                 String   @id @default(cuid())
