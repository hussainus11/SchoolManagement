  category     String
  severity     DisciplineSeverity @default(MINOR)
  description  String
  actionTaken  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school     School  @relation(fields: [schoolId], references: [id])
  student    Student @relation(fields: [studentId], references: [id])
  reportedBy User    @relation("IncidentReportedBy", fields: [reportedById], references: [id])

  @@index([schoolId])
  @@index([studentId])
}

model Visitor {
  id           String    @id @default(cuid())
  schoolId     String
  branchId     String
  name         String
  phone        String?
  purpose      String
  personToMeet String?
  checkInAt    DateTime  @default(now())
  checkOutAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([schoolId])
}

model Alumni {
  id                String   @id @default(cuid())
  schoolId          String
  studentId         String?  @unique
  firstName         String
  lastName          String
  graduationYear    Int
  currentOccupation String?
  contactEmail      String?
  contactPhone      String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([schoolId])
}

model Document {
  id           String            @id @default(cuid())
  schoolId     String
  ownerType    DocumentOwnerType
  ownerId      String
  title        String
  fileUrl      String
  fileName     String
  mimeType     String
  fileSize     Int
  uploadedById String
  createdAt    DateTime          @default(now())

  school     School @relation(fields: [schoolId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([schoolId, ownerType, ownerId])
}
