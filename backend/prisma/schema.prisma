  @@index([schoolId, status])
}

model LeaveType {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  school        School                 @relation(fields: [schoolId], references: [id])
  leaveRequests LeaveRequest[]
  allocations   LeaveGroupAllocation[]

  @@unique([schoolId, name])
}

model LeaveGroup {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  allocations LeaveGroupAllocation[]
  teachers    Teacher[]
  staff       Staff[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model LeaveGroupAllocation {
  id           String @id @default(cuid())
  leaveGroupId String
  leaveTypeId  String
  daysPerYear  Float

  leaveGroup LeaveGroup @relation(fields: [leaveGroupId], references: [id], onDelete: Cascade)
  leaveType  LeaveType  @relation(fields: [leaveTypeId], references: [id])

  @@unique([leaveGroupId, leaveTypeId])
  @@index([leaveGroupId])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  schoolId     String
  teacherId    String?
  staffId      String?
